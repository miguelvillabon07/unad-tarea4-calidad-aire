{
  "name": "Calidad del aire - IDEAM",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    },
    "codespaces": {
      "openFiles": [
        "README.md",
        "app.py"
      ]
    }
  },
  "postCreateCommand": "python -m pip install -r requirements.txt",
  "postAttachCommand": "python -m streamlit run app.py --server.headless true --server.address 0.0.0.0 --server.port 8501",
  "portsAttributes": {
    "8501": {
      "label": "Dashboard IDEAM",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8501
  ]
}
